# Phase 1: local development only. Change this password before any deployment.
POSTGRES_USER=ref
POSTGRES_PASSWORD=ref_local_only
POSTGRES_DB=ask_the_ref
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ref:ref_local_only@localhost:5432/ask_the_ref

# Phase 2 uses pinned local models in models.lock.json; no API key required.
# Phase 3 runs locally with Ollama. No API key or paid service.
LLM_NUM_GPU=-1
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=3000
EMBEDDING_DIMENSIONS=384

# Phase 6/7: optional tracing and frontend configuration.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ask-the-ref
NEXT_PUBLIC_API_URL=http://localhost:8000
